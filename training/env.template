# MySQL Database Configuration
# Copy this file to .env (in repo root or next to the scripts) and update with your actual values.

# MySQL Host (e.g. 'localhost' for local, 'db' if using docker-compose)
MYSQL_HOST=localhost

# MySQL Port
MYSQL_PORT=3306

# Database Name
MYSQL_DB=carpricing

# MySQL User
MYSQL_USER=car_user

# MySQL Password
MYSQL_PASSWORD=your_password_here
